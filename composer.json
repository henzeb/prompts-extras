{
  "name": "henzeb/prompts-extras",
  "description": "Extending Laravel Prompts",
  "keywords": [
    "laravel",
    "prompt",
    "prompts",
    "busybox",
    "watch"
  ],
  "homepage": "https://github.com/henzeb/prompts-extras",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Henze Berkheij",
      "email": "henzeberkheij@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "laravel/prompts": "^0.3.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.1.0",
    "laravel/pint": "^1.0.0",
    "mockery/mockery": "^1.6.13",
    "orchestra/testbench": "^10.0.0|^11.0",
    "pestphp/pest": "^3.8.5|^4.0|^5.0",
    "pestphp/pest-plugin-laravel": "^3.1.0|^4.0|^5.0",
    "phpstan/phpstan": "^2.1.3",
    "phpstan/phpstan-mockery": "^2.0.0"
  },
  "suggest": {
    "ext-pcntl": "*"
  },
  "autoload": {
    "psr-4": {
      "Henzeb\\Prompts\\": "src/"
    },
    "files": [
      "src/output_helpers.php",
      "src/input_helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Henzeb\\Prompts\\Illuminate\\Providers\\PromptsExtrasProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage-html coverage",
    "test-mutations": "XDEBUG_MODE=coverage vendor/bin/pest --mutate --covered-only"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "prefer-stable": true,
  "minimum-stability": "stable"
}
